*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# ========== 环境变量 ==========
.env
.env.local

# ========== 文档文件（可选，根据需求决定是否提交）==========
# QUICKSTART.md
# README_BUILD.md
# IMPLEMENTATION_SUMMARY.md

# Build output (混淆后的构建输出)
dist/

# Dependencies (依赖文件夹)
node_modules/

# IDE configurations (IDE 配置文件)
.vscode/
*.code-workspace
*.code-workspace.backup

# Browser metadata (浏览器自动生成的元数据)
_metadata/

