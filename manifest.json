{
  "manifest_version": 3,
  "name": "葡萄广告拦截器",
  "version": "3.4",
  "description": "专门针对 HLS (m3u8) 视频流的 SSAI 广告拦截工具。利用"递归 Blob 代理"技术和"动态帧率指纹"算法，深度净化主索引与变体索引，无损过滤隐藏广告。",
  "icons": {
    "32": "icon_32.png",
    "64": "icon_64.png",
    "128": "icon_128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "exclude_matches": [
        "*://*.youtube.com/*",
        "*://*.bilibili.com/*",
        "*://*.netflix.com/*",
        "*://*.disneyplus.com/*",
        "*://*.max.com/*",
        "*://*.hulu.com/*",
        "*://*.amazon.com/*",
        "*://*.amazon.co.jp/*",
        "*://*.amazon.de/*",
        "*://*.amazon.co.uk/*",
        "*://*.iqiyi.com/*",
        "*://*.iq.com/*",
        "*://v.qq.com/*",
        "*://*.youku.com/*",
        "*://*.mgtv.com/*",
        "*://*.ixigua.com/*",
        "*://*.douyin.com/*",
        "*://*.tiktok.com/*",
        "*://*.twitch.tv/*",
        "*://*.nicovideo.jp/*",
        "*://*.acfun.cn/*",
        "*://*.huya.com/*",
        "*://*.douyu.com/*",
        "*://*.weibo.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.facebook.com/*",
        "*://*.instagram.com/*"
      ],
      "js": ["loader.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*/*"],
      "exclude_matches": [
        "*://*.youtube.com/*",
        "*://*.bilibili.com/*",
        "*://*.netflix.com/*",
        "*://*.disneyplus.com/*",
        "*://*.max.com/*",
        "*://*.hulu.com/*",
        "*://*.amazon.com/*",
        "*://*.amazon.co.jp/*",
        "*://*.amazon.de/*",
        "*://*.amazon.co.uk/*",
        "*://*.iqiyi.com/*",
        "*://*.iq.com/*",
        "*://v.qq.com/*",
        "*://*.youku.com/*",
        "*://*.mgtv.com/*",
        "*://*.ixigua.com/*",
        "*://*.douyin.com/*",
        "*://*.tiktok.com/*",
        "*://*.twitch.tv/*",
        "*://*.nicovideo.jp/*",
        "*://*.acfun.cn/*",
        "*://*.huya.com/*",
        "*://*.douyu.com/*",
        "*://*.weibo.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.facebook.com/*",
        "*://*.instagram.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/hls.min.js"],
      "matches": ["*://*/*"]
    }
  ]
}
